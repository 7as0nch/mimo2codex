{
  "name": "mimo-computer-use",
  "version": "0.1.0",
  "description": "Codex MCP plugin that adapts Windows-MCP, Peekaboo, and Trope CUA for MiMo-friendly computer use.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "bin": {
    "mimo-computer-use": "./server/index.mjs"
  },
  "scripts": {
    "start": "node ./server/index.mjs",
